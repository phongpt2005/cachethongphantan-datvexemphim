# Frontend Load Balancer (chạy trên NODE 3): một địa chỉ duy nhất cho client,
# chia đều yêu cầu cho API Gateway của cả 2 máy; máy nào chết thì tự né sang máy còn lại.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=200r/s;

upstream gateway_cluster {
    zone gateway_cluster 64k;   # bộ đếm round-robin dùng chung cho mọi worker của nginx
    server ${NODE1_IP}:3000 max_fails=1 fail_timeout=10s;
    server ${NODE2_IP}:3100 max_fails=1 fail_timeout=10s;
}

server {
    listen 80;
    limit_req zone=api_limit burst=100 nodelay;
    limit_req_status 429;

    location / {
        proxy_pass http://gateway_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        # Máy đang failover / mất quorum trả 503 -> thử lại ở máy còn lại. Cho phép cả POST (non_idempotent)
        # vì đặt vé được khoá ghế trên Primary bảo vệ: gửi lại tối đa nhận 409, không bao giờ bán trùng.
        proxy_next_upstream error timeout http_502 http_503 http_504 non_idempotent;
        proxy_next_upstream_tries 2;
        add_header X-Upstream $upstream_addr always;
    }

    location = /lb-health {
        default_type application/json;
        return 200 '{"status":"ok","component":"frontend-lb","upstreams":["${NODE1_IP}:3000","${NODE2_IP}:3100"]}\n';
    }
}
